# Copiez ce fichier en .env (jamais commité) et renseignez vos propres valeurs.

# Obligatoire. Secret utilisé pour signer les jetons de connexion (JWT).
# Ne JAMAIS le committer ni le mettre dans le code frontend.
# Générez-en un long et aléatoire, par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port d'écoute du serveur API (et du site en production).
PORT=3001

# Interface réseau d'écoute. 0.0.0.0 = accessible depuis les autres appareils
# du même réseau (ex: votre téléphone), pas seulement localhost.
HOST=0.0.0.0

# Chemin du fichier de base de données SQLite. En production, faites pointer
# ce chemin vers un disque persistant (voir README pour le déploiement).
DB_PATH=./data/financeflow.db

# Optionnel. À définir uniquement si le frontend est hébergé sur un domaine
# différent de l'API (déploiement "split"). Laissez vide si vous déployez
# l'application comme un seul service (recommandé).
CORS_ORIGIN=
